<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Assembly-CSharp</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <TargetFramework>net472</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
    <!-- 允许 BinaryFormatter (Unity Mono/.NET 4.x 仍然使用，但 .NET 8 默认禁用) -->
    <NoWarn>$(NoWarn);SYSLIB0011</NoWarn>
    <!-- 关闭反编译产生的噪音警告 (不影响功能) -->
    <NoWarn>$(NoWarn);CS8981</NoWarn>  <!-- 类名全小写 -->
    <NoWarn>$(NoWarn);CS0649</NoWarn>  <!-- 字段未赋值 -->
    <NoWarn>$(NoWarn);CS0169</NoWarn>  <!-- 字段未使用 -->
    <NoWarn>$(NoWarn);CS0414</NoWarn>  <!-- 字段赋值但未读 -->
    <NoWarn>$(NoWarn);CS0219</NoWarn>  <!-- 局部变量未用 -->
    <NoWarn>$(NoWarn);CS0618</NoWarn>  <!-- obsolete Unity API -->
    <!-- 保留真实编译错误 (CS 非 SYSLIB) -->
  </PropertyGroup>
  <PropertyGroup />
  <ItemGroup>
    <!-- 排除备份目录，避免类重复定义 -->
    <Compile Remove="baseline_backup/**/*.cs" />
    <Compile Remove="decompiled.backup/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Core">
      <HintPath>../1.8.5_Resources/Data/Managed/System.Core.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>../1.8.5_Resources/Data/Managed/UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>../1.8.5_Resources/Data/Managed/Unity.TextMeshPro.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>../1.8.5_Resources/Data/Managed/UnityEngine.UI.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>../1.8.5_Resources/Data/Managed/UnityEngine.TextRenderingModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>../1.8.5_Resources/Data/Managed/UnityEngine.UIModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>../1.8.5_Resources/Data/Managed/UnityEngine.AudioModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>../1.8.5_Resources/Data/Managed/UnityEngine.IMGUIModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>../1.8.5_Resources/Data/Managed/UnityEngine.PhysicsModule.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>../1.8.5_Resources/Data/Managed/Assembly-CSharp-firstpass.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>../1.8.5_Resources/Data/Managed/UnityEngine.InputLegacyModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.Physics2DModule">
      <HintPath>../1.8.5_Resources/Data/Managed/UnityEngine.Physics2DModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.JSONSerializeModule">
      <HintPath>../1.8.5_Resources/Data/Managed/UnityEngine.JSONSerializeModule.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>